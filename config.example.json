      "type": "rss",
      "url": "https://www.example.org/jobs/feed.xml",
      "location": "",
      "enabled": false
    }
  ],

  "scoring": {
    "title_keywords": {
      "data": 3, "daten": 3, "reporting": 3, "berichtswesen": 3, "controlling": 3, "controller": 3,
      "analyst": 3, "business intelligence": 3, "wissenschaftsmanagement": 3, "hochschulcontrolling": 3,
      "digitalisierung": 2, "prozess": 2, "qualitätsmanagement": 2, "forschungsförderung": 2,
